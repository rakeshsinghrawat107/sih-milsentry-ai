# ==============================================================================
# CYBER CONSTELLATION - Environment Configuration
# ==============================================================================

# ── SERVER SETTINGS ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── API KEYS ─────────────────────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your VirusTotal API key from: https://www.virustotal.com/gui/user/username/apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Get your Shodan API key from: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# ── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Set to 'false' to force the platform to use synthetic demo data even if keys are provided
ENABLE_LIVE_API_SCANS=true
